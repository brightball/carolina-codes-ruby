#!/usr/bin/env bash
# In-repo pre-commit entry. Prefer the pre-commit runner so named hooks
# match .pre-commit-config.yaml; fall back to the same Rake targets.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"
if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run --hook-stage pre-commit --all-files
fi
bundle exec rake test
semgrep scan --config p/ruby --error --metrics off --no-git-ignore --exclude vendor --exclude .git
bundle exec rake audit
gitleaks protect --staged --verbose
bundle exec rake lint
